# true: cadastro, pesquisa e identificação usam apenas o SQLite do aparelho.
# false: conclusão e consultas usam a API do GoiásPen.
EXPO_PUBLIC_USE_LOCAL_DATABASE=false

# true: embedding/validação no uvicorn local.
# false: API Python do DNS (homo no Expo, prod no release).
EXPO_PUBLIC_USE_LOCAL_BIOMETRIA_API=false

# Só usado quando EXPO_PUBLIC_USE_LOCAL_BIOMETRIA_API=true.
# Aparelho na Wi-Fi: IP do Mac. Simulator: http://localhost:8000
EXPO_PUBLIC_BIOMETRIA_API_URL=http://172.20.10.5:8000

# Distância L2 dos embeddings normalizados (menor = mais parecido).
EXPO_PUBLIC_LOCAL_FACE_MATCH_THRESHOLD=1.1
EXPO_PUBLIC_LOCAL_FACE_CANDIDATE_THRESHOLD=1.3

# Build de homologação (IPA/APK, não é __DEV__): EXPO_PUBLIC_AMBIENTE=HOMO
# EXPO_PUBLIC_AMBIENTE=HOMO
